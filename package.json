{
  "name": "doxmind",
  "version": "1.6.0",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@swc/helpers": "^0.5.17"
  },
  "scripts": {
    "dev": "next dev",
    "dev:mobile": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "cross-env VITE_CJS_IGNORE_WARNING=true vitest",
    "test:e2e": "playwright test",
    "preflight:gui": "cross-env VITE_CJS_IGNORE_WARNING=true vitest run src/__tests__/preflight/gui-preflight.test.tsx --reporter=verbose",
    "preflight:excel": "node scripts/preflight-excel.mjs",
    "test:ui": "cross-env VITE_CJS_IGNORE_WARNING=true vitest --ui",
    "test:coverage": "cross-env VITE_CJS_IGNORE_WARNING=true vitest run --coverage",
    "test:ci": "cross-env VITE_CJS_IGNORE_WARNING=true vitest run --reporter=verbose",
    "test:ci:coverage": "cross-env VITE_CJS_IGNORE_WARNING=true vitest run --coverage --reporter=verbose",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "husky",
    "server": "cd server && python -m uvicorn main:app --reload --host 127.0.0.1 --port 8000",
    "dev:all": "node scripts/dev.mjs",
    "tauri": "tauri",
    "icons": "node scripts/build-app-icon.mjs",
    "dev:desktop": "node scripts/desktop-dev.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:desktop": "node scripts/build-sidecar.mjs && tauri build --config src-tauri/tauri.bundle.conf.json",
    "gen:outline-stress": "node scripts/generate-outline-stress-md.mjs",
    "electron": "electron .",
    "electron:smoke": "node scripts/electron-smoke.mjs",
    "build:sidecar:electron": "node scripts/build-sidecar.mjs --electron",
    "dist:electron": "npm run build:sidecar:electron && npm run build && electron-builder --publish never",
    "release:electron": "npm run build:sidecar:electron && npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.13.21",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tiptap/core": "^3.23.6",
    "@tiptap/extension-code-block": "^3.23.6",
    "@tiptap/extension-code-block-lowlight": "^3.23.6",
    "@tiptap/extension-color": "^3.23.6",
    "@tiptap/extension-highlight": "^3.23.6",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-table": "^3.23.6",
    "@tiptap/extension-table-cell": "^3.23.6",
    "@tiptap/extension-table-header": "^3.23.6",
    "@tiptap/extension-table-row": "^3.23.6",
    "@tiptap/extension-task-item": "^3.23.6",
    "@tiptap/extension-task-list": "^3.23.6",
    "@tiptap/extension-text-align": "^3.23.6",
    "@tiptap/extension-text-style": "^3.23.6",
    "@tiptap/extension-typography": "^3.23.6",
    "@tiptap/extension-underline": "^3.23.6",
    "@tiptap/markdown": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@tiptap/suggestion": "^3.23.6",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "diff": "^8.0.3",
    "dompurify": "^3.3.1",
    "framer-motion": "^12.26.2",
    "html-to-image": "^1.11.13",
    "hyperformula": "^3.2.0",
    "immer": "^11.1.3",
    "katex": "^0.16.27",
    "lowlight": "^3.2.0",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.4",
    "mermaid": "^11.12.3",
    "next": "^15.1.0",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.4",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.15",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/diff": "^7.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.15.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
