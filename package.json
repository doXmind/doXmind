{
  "name": "doxmind",
  "version": "1.11.0",
  "description": "A fully local, Markdown-native knowledge workspace.",
  "author": "doXmind",
  "license": "Apache-2.0",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@swc/helpers": "^0.5.17",
    "postcss": "$postcss",
    "next": {
      "sharp": "^0.35.0"
    }
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "cross-env VITE_CJS_IGNORE_WARNING=true vitest",
    "test:e2e": "playwright test",
    "preflight:gui": "cross-env VITE_CJS_IGNORE_WARNING=true vitest run src/__tests__/preflight/gui-preflight.test.tsx --reporter=verbose",
    "preflight:excel": "node scripts/preflight-excel.mjs",
    "test:ui": "cross-env VITE_CJS_IGNORE_WARNING=true vitest --ui",
    "test:coverage": "cross-env VITE_CJS_IGNORE_WARNING=true vitest run --coverage",
    "test:ci": "cross-env VITE_CJS_IGNORE_WARNING=true vitest run --reporter=verbose",
    "test:ci:coverage": "cross-env VITE_CJS_IGNORE_WARNING=true vitest run --coverage --reporter=verbose",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "husky",
    "server": "cd server && python -m uvicorn main:app --reload --host 127.0.0.1 --port 8000",
    "dev:all": "node scripts/dev.mjs",
    "electron": "electron .",
    "electron:test-native": "node --test scripts/tests/*.test.mjs",
    "electron:smoke": "node scripts/electron-smoke.mjs",
    "test:electron-gui": "node scripts/electron-gui-acceptance.mjs",
    "dist:electron": "node scripts/build-frontend.mjs && electron-builder --publish never"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.26.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.27",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.4",
    "mermaid": "^11.16.0",
    "next": "^15.5.21",
    "next-intl": "^4.13.3",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.15.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "plist": "^3.1.0",
    "postcss": "^8.5.21",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
