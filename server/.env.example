# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI API Key (optional, for embeddings)
OPENAI_API_KEY=

# Database
DATABASE_URL=sqlite:///./data/app.db

# Vector Store
CHROMA_PERSIST_DIR=./data/chroma

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# =============================================================================
# Security Configuration
# =============================================================================

# JWT Secret Key (REQUIRED for production - generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-secret-key-change-in-production

# JWT Token Expiration (in minutes, default: 7 days = 10080)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# API Key for external integrations (optional)
API_KEY=

# Rate Limiting (per minute)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# =============================================================================
# Email Service (SMTP)
# =============================================================================

# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=doXmind
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true

# =============================================================================
# Google OAuth
# =============================================================================

# Get from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Verification Settings
# =============================================================================

EMAIL_VERIFICATION_EXPIRE_MINUTES=15
PASSWORD_RESET_EXPIRE_HOURS=1
MAX_VERIFICATION_ATTEMPTS=5
