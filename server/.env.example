# doXmind Mini — local desktop edition
#
# Everything is optional: the GUI Settings page lets you paste the API keys
# at runtime and writes them to ~/.doxmind/config.json. Use this file only
# if you prefer environment variables for development.

# OpenRouter (LLM access — required for AI features)
OPENROUTER_API_KEY=

# Google Serper (optional — enables web search tool)
SERPER_API_KEY=

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Override the data directory if you don't want ~/.doxmind
# DATA_DIR=/path/to/your/doxmind-data
