# OpenRouter API Key (required for LLM access)
OPENROUTER_API_KEY=sk-or-xxx

# OpenRouter Base URL (optional, defaults to https://openrouter.ai/api)
# OPENROUTER_BASE_URL=https://openrouter.ai/api

# Google Serper API Key (optional, for web search tool)
SERPER_API_KEY=

# =============================================================================
# AWS S3 (Image Storage)
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=doxmind
AWS_S3_REGION=us-east-1

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# Local Docker: postgresql+asyncpg://doxmind:doxmind123@localhost:5433/doxmind
# Note: Using port 5433 to avoid conflict with local PostgreSQL installations
DATABASE_URL=postgresql+asyncpg://doxmind:doxmind123@localhost:5433/doxmind

# =============================================================================
# Server
# =============================================================================
HOST=0.0.0.0
PORT=8000
DEBUG=true

# =============================================================================
# Security Configuration
# =============================================================================

# JWT Secret Key (REQUIRED for production - generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-secret-key-change-in-production

# JWT Token Expiration
# IMPORTANT: Dual-Token System (短期access token + 长期refresh token)
# - Access token: 15 minutes (stored in localStorage, for API requests)
# - Refresh token: 30 days (HttpOnly cookie, for token renewal)
#
# Migration Strategy:
# - Initial deployment: Keep 10080 (7 days) for smooth transition
# - After 1 week: Switch to 15 minutes for enhanced security
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080  # TODO: Change to 15 after user migration

# Refresh Token Expiration (in days, default: 30 days)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookie Configuration (for HttpOnly refresh tokens)
COOKIE_SECURE=false  # Set to true in production (HTTPS only)
COOKIE_SAMESITE=lax  # CSRF protection: lax, strict, or none
COOKIE_DOMAIN=  # Leave empty for localhost, set to .doxmind.com for production

# API Key for external integrations (optional)
API_KEY=

# API Key Encryption Key (required for user API key feature)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=

# Rate Limiting (per minute)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# =============================================================================
# Email Service (SMTP)
# =============================================================================

# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=doXmind
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true

# =============================================================================
# Google OAuth
# =============================================================================

# Get from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Verification Settings
# =============================================================================

EMAIL_VERIFICATION_EXPIRE_MINUTES=15
PASSWORD_RESET_EXPIRE_HOURS=1
MAX_VERIFICATION_ATTEMPTS=5
