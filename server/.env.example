# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI API Key (required for vector search embeddings)
OPENAI_API_KEY=sk-xxx

# Google API Key (required for file conversion: PDF, DOCX, PPTX to Markdown)
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# CourtListener API Key (optional, for legal case search)
# Get from: https://www.courtlistener.com/api/
COURTLISTENER_API_KEY=

# =============================================================================
# Database (PostgreSQL with pgvector)
# =============================================================================
# Local Docker: postgresql+asyncpg://doxmind:doxmind123@localhost:5433/doxmind
# Note: Using port 5433 to avoid conflict with local PostgreSQL installations
# Heroku: postgres:// URLs are auto-converted to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://doxmind:doxmind123@localhost:5433/doxmind

# Vector search (pgvector)
PGVECTOR_ENABLED=true

# =============================================================================
# Server
# =============================================================================
HOST=0.0.0.0
PORT=8000
DEBUG=true

# =============================================================================
# Security Configuration
# =============================================================================

# JWT Secret Key (REQUIRED for production - generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-secret-key-change-in-production

# JWT Token Expiration (in minutes, default: 7 days = 10080)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# API Key for external integrations (optional)
API_KEY=

# API Key Encryption Key (required for user API key feature)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=

# Rate Limiting (per minute)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# =============================================================================
# Email Service (SMTP)
# =============================================================================

# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=doXmind
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true

# =============================================================================
# Google OAuth
# =============================================================================

# Get from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Verification Settings
# =============================================================================

EMAIL_VERIFICATION_EXPIRE_MINUTES=15
PASSWORD_RESET_EXPIRE_HOURS=1
MAX_VERIFICATION_ATTEMPTS=5
