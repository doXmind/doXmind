        "color": "#000000",
        "fontFamily": "Helvetica",
        "fontSize": 11,
        "originalText": "The local sidecar edition deliberately drops several surfaces from earlier branches. None of these should reappear by accident.",
        "pageIndex": 1,
        "styleRanges": [
          {
            "color": "#000000",
            "end": 98,
            "start": 0
