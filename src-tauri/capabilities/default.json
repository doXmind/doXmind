{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the doXmind desktop window",
  "windows": ["main", "doc-*"],
  "remote": {
    "urls": ["http://localhost:*/*", "http://127.0.0.1:*/*"]
  },
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-destroy",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "core:path:default",
    "shell:allow-open",
    "dialog:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "allow-workspace-commands"
  ]
}
