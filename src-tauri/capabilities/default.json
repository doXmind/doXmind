{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the doXmind desktop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "core:path:default",
    "shell:allow-open",
    "dialog:default",
    "opener:default"
  ]
}
