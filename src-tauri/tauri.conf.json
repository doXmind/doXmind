{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "doXmind",
  "version": "0.1.0",
  "identifier": "com.doxmind.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node scripts/build-frontend.mjs",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": null
    },
    "category": "Productivity",
    "shortDescription": "Local-first AI writing studio",
    "longDescription": "doXmind is a local-first AI writing assistant — TipTap WYSIWYG editor, KB, autocomplete, and chat, all running on your machine."
  },
  "plugins": {}
}
