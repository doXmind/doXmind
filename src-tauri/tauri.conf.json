{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "doXmind",
  "version": "1.1.9",
  "identifier": "com.doxmind.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node scripts/build-frontend.mjs",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "Developer ID Application: wangzhang wu (46KF5Z549N)",
      "entitlements": null,
      "dmg": {
        "background": "dmg/background.png",
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "category": "Productivity",
    "shortDescription": "Local-first Markdown workspace",
    "longDescription": "doXmind is a local-first desktop Markdown workspace. Documents stay as portable .md files, while hidden .doxmind sidecars preserve rich editor state and structured blocks.",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor",
        "rank": "Owner"
      },
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "PDF document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["xlsx", "xlsm"],
        "name": "Excel Workbook",
        "description": "Excel workbook",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  },
  "plugins": {}
}
