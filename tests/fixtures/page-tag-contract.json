{
  "comment": "One inline-tag grammar, implemented in src/lib/tags.ts and again in electron/native-workspace.js. Both read this.",
  "cases": [
    {
      "name": "a plain tag",
      "text": "see #project here",
      "tags": ["project"]
    },
    {
      "name": "nested tags keep their slashes",
      "text": "#project/web and #a/b/c",
      "tags": ["project/web", "a/b/c"]
    },
    {
      "name": "at the start of a line",
      "text": "#inbox first",
      "tags": ["inbox"]
    },
    {
      "name": "after an opening bracket",
      "text": "(#note) and [#other]",
      "tags": ["note", "other"]
    },
    {
      "name": "a sharp in a word is not a tag",
      "text": "C# and F# are languages",
      "tags": []
    },
    {
      "name": "a URL fragment is not a tag",
      "text": "src/lib#anchor",
      "tags": []
    },
    {
      "name": "an all-digit run is a number, not a tag",
      "text": "in #1984 and #42",
      "tags": []
    },
    {
      "name": "digits are fine with a letter",
      "text": "#q3 and #2026goals",
      "tags": ["q3", "2026goals"]
    },
    {
      "name": "underscores and dashes",
      "text": "#my_tag #my-tag",
      "tags": ["my_tag", "my-tag"]
    },
    {
      "name": "a bare hash is not a tag",
      "text": "# Heading",
      "tags": []
    },
    {
      "name": "an empty path segment is not a tag",
      "text": "#a//b #a/ #/a",
      "tags": []
    },
    {
      "name": "punctuation ends a tag",
      "text": "#done, #next. #last!",
      "tags": ["done", "next", "last"]
    },
    {
      "name": "a CJK tag is a tag",
      "text": "这是 #项目 的笔记，还有 #项目/网页",
      "tags": ["项目", "项目/网页"]
    },
    {
      "name": "a CJK word before a hash still blocks it",
      "text": "笔记#项目",
      "tags": []
    }
  ]
}
